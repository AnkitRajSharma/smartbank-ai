# Copy values into your shell environment or a local .env file (never commit secrets).
SMARTBANK_JWT_SECRET=replace-with-a-long-random-secret
SMARTBANK_COOKIE_SECURE=false
GEMINI_API_KEY=
# Optional model override; default is gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
