# SmartBank AI Environment Configuration Template
# Copy values into your shell environment or a local .env file (never commit secrets).

# Google Gemini LLM API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=15000

# Authentication & Security Keys
# Generate a strong 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SMARTBANK_JWT_SECRET=replace-with-a-long-random-secret
SMARTBANK_JWT_TTL_SECONDS=7200
SMARTBANK_COOKIE_SECURE=false

# Demo Account Credentials (Optional overrides)
DEMO_CUSTOMER1_EMAIL=customer1@smartbank.demo
DEMO_CUSTOMER1_PASSWORD=your-customer1-password
DEMO_CUSTOMER2_EMAIL=customer2@smartbank.demo
DEMO_CUSTOMER2_PASSWORD=your-customer2-password
DEMO_CUSTOMER3_EMAIL=customer3@smartbank.demo
DEMO_CUSTOMER3_PASSWORD=your-customer3-password
DEMO_ANALYTICS_EMAIL=analytics@smartbank.demo
DEMO_ANALYTICS_PASSWORD=your-analytics-password
